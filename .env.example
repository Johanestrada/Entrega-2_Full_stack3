# Local Docker Compose configuration
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=colegio
MYSQL_USER=user
MYSQL_PASSWORD=change-me

RABBITMQ_USERNAME=colegio_app
RABBITMQ_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_DE_6_A_128_CARACTERES
RABBITMQ_MANAGEMENT_BIND_IP=127.0.0.1
RABBITMQ_ERLANG_COOKIE=REEMPLAZAR_COOKIE
RABBITMQ_CLUSTER_NETWORK=colegio-network

KAFKA_NETWORK_NAME=colegio-network
KAFKA_BOOTSTRAP_SERVERS=kafka-1:19092,kafka-2:19093,kafka-3:19094
KAFKA_UI_PORT=8090
KAFKA_ZOOKEEPER_PORT=2181
KAFKA_BROKER_1_PORT=9092
KAFKA_BROKER_2_PORT=9093
KAFKA_BROKER_3_PORT=9094

IMAGE_PREFIX=
IMAGE_TAG=latest
API_BASE_URL=http://localhost:8084

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/colegio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQL8Dialect

EUREKA_URL=http://eureka-server:8761/eureka
ESTUDIANTE_SERVICE_URL=http://estudiante-service:8081
ASISTENCIA_SERVICE_URL=http://asistencia-service:8082
EVALUACION_SERVICE_URL=http://evaluacion-service:8083
JWT_ISSUER_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
JWT_AUDIENCE=YOUR_API_CLIENT_ID
CORS_ALLOWED_ORIGINS=http://localhost:4173
