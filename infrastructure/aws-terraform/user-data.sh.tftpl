#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/colegio-user-data.log | logger -t colegio-user-data -s 2>/dev/console) 2>&1
dnf update -y
dnf install -y git docker
systemctl enable --now docker
usermod -aG docker ec2-user
mkdir -p /usr/local/lib/docker/cli-plugins
curl -L https://github.com/docker/compose/releases/download/v2.27.0/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
git clone --branch ${branch} ${repository_url} /opt/colegio
cd /opt/colegio
for environment_file in frontend-angular/src/environments/environment.ts frontend-angular/src/environments/environment.prod.ts; do
	if [ -f "$environment_file" ]; then
		sed -i -E "s#tenantId: '[^']*'#tenantId: '${entra_tenant}'#; s#clientId: '[^']*'#clientId: '${client_id}'#; s#apiScope: '[^']*'#apiScope: '${api_scope}'#" "$environment_file"
	fi
done
cat > frontend-angular/nginx.conf <<'NGINX_CONFIG'
server {
	listen 80;
	listen [::]:80;
	server_name _;

	root /usr/share/nginx/html;
	index index.html;

	location / {
		try_files $uri $uri/ /index.html;
	}
}
NGINX_CONFIG
if ! grep -q 'COPY nginx.conf /etc/nginx/conf.d/default.conf' frontend-angular/Dockerfile; then
	sed -i '/COPY --from=build \/app\/dist\/frontend-angular\/browser \/usr\/share\/nginx\/html/a COPY nginx.conf /etc/nginx/conf.d/default.conf' frontend-angular/Dockerfile
fi
metadata_token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
	-H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
metadata_headers=(-H "X-aws-ec2-metadata-token: $metadata_token")
public_hostname=$(curl -fsS "$${metadata_headers[@]}" \
	http://169.254.169.254/latest/meta-data/public-hostname || true)
if [ -z "$public_hostname" ]; then
	public_hostname=$(curl -fsS "$${metadata_headers[@]}" \
		http://169.254.169.254/latest/meta-data/public-ipv4)
fi
if [ "${cors_origins}" = "auto" ]; then
	cors_origin="*"
else
	cors_origin="${cors_origins}"
fi
cat > .env <<EOF
MYSQL_ROOT_PASSWORD=unused
MYSQL_DATABASE=colegio
MYSQL_USER=${db_user}
MYSQL_PASSWORD=${db_password}
SPRING_DATASOURCE_URL=jdbc:mysql://${db_host}:3306/colegio?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${db_user}
SPRING_DATASOURCE_PASSWORD=${db_password}
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQL8Dialect
EUREKA_URL=http://eureka-server:8761/eureka
ESTUDIANTE_SERVICE_URL=http://estudiante-service:8081
ASISTENCIA_SERVICE_URL=http://asistencia-service:8082
EVALUACION_SERVICE_URL=http://evaluacion-service:8083
JWT_ISSUER_URI=${issuer}
JWT_AUDIENCE=${audience}
CORS_ALLOWED_ORIGINS=$${cors_origin}
API_BASE_URL=${api_url}
IMAGE_PREFIX=${image_prefix}
IMAGE_TAG=${image_tag}
EOF
# Use published images when configured; otherwise build from the cloned repository.
image_prefix_value="${image_prefix}"
if [ -n "$image_prefix_value" ]; then
	if ! docker compose pull; then
		echo "No se pudieron descargar todas las imagenes; se construiran localmente."
		docker compose build
	fi
else
	echo "IMAGE_PREFIX vacio; se construiran las imagenes localmente."
	docker compose build
fi
docker compose up -d
